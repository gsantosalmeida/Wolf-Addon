// ============================================================================
// Mesa Arcana - UI própria (estilo "console": abas + grade de slots + painéis)
// Layout e texturas (textures/ui/wolf_*.png) originais do projeto.
//
// Formulários SEM a etiqueta no título continuam vanilla (vanilla_wrapper).
// Formulários COM a etiqueta (§r§r§r§r) usam o mesa_layout. O script marca cada
// botão com um marcador INVISÍVEL; o JSON usa o marcador para decidir onde ele aparece:
//   §1§r slot   §3§r aba   §5§r seta   §9§r resultado   §b§r Fabricar   §d§r ingrediente
//   flags: §4§r = vermelho (falta material)   §e§r = selecionado
// ============================================================================
{
  "namespace": "server_form",
  "mesa_slot_btn": {
    "type": "button",
    "size": [
      22,
      22
    ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.form_button_click",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.form_button_click",
        "mapping_type": "focused"
      }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§1§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "default": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/ui/wolf_hover",
          "layer": 6,
          "size": [
            "100%",
            "100%"
          ],
          "keep_ratio": false
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/ui/wolf_hover",
          "layer": 6,
          "size": [
            "100%",
            "100%"
          ],
          "color": [
            0.7,
            0.7,
            0.7
          ],
          "keep_ratio": false
        }
      },
      {
        "bg": {
          "type": "image",
          "texture": "textures/ui/wolf_slot",
          "layer": 1,
          "size": [
            "100%",
            "100%"
          ],
          "nineslice_size": 3
        }
      },
      {
        "bg_red": {
          "type": "image",
          "texture": "textures/ui/wolf_slot_red",
          "layer": 2,
          "size": [
            "100%",
            "100%"
          ],
          "nineslice_size": 3,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#form_button_text - '§4§r') = #form_button_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "icon": {
          "type": "image",
          "layer": 3,
          "size": [
            16,
            16
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "sel": {
          "type": "image",
          "texture": "textures/ui/wolf_slot_sel",
          "layer": 4,
          "size": [
            "100%",
            "100%"
          ],
          "nineslice_size": 3,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#form_button_text - '§e§r') = #form_button_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "btn_label": {
          "type": "label",
          "layer": 5,
          "anchor_from": "center",
          "anchor_to": "center",
          "font_scale_factor": 0.6,
          "color": "$main_header_text_color",
          "text": "#form_button_text",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },
