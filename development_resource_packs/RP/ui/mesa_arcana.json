{
  "namespace": "mesa_arcana",

  "mesa_arcana_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 50,
    "controls": [
      { "dim@mesa_arcana.dim_bg": {} },
      { "main@mesa_arcana.main_window": {} }
    ]
  },

  "dim_bg": {
    "type": "image",
    "texture": "textures/ui/mesa_bg",
    "alpha": 0.72,
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "main_window": {
    "type": "panel",
    "size": [ 360, 240 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      { "frame@mesa_arcana.window_frame": {} },
      { "titlebar@mesa_arcana.title_bar": {} },
      { "title@mesa_arcana.title_text": {} },
      { "close@mesa_arcana.close_btn": {} },
      { "left@mesa_arcana.left_panel": {} },
      { "center@mesa_arcana.center_panel": {} },
      { "bottom@mesa_arcana.bottom_bar": {} }
    ]
  },

  "window_frame": {
    "type": "image",
    "texture": "textures/ui/mesa_frame",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "title_bar": {
    "type": "image",
    "texture": "textures/ui/mesa_titlebar",
    "size": [ 340, 18 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 6 ]
  },

  "title_text": {
    "type": "label",
    "text": "§5§l✦ Mesa Arcana ✦",
    "color": [ 0.85, 0.7, 1.0 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 8 ],
    "layer": 5
  },

  "close_btn": {
    "type": "button",
    "size": [ 16, 16 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -10, 8 ],
    "layer": 10,
    "$pressed_button_name": "button.form_button_close",
    "default_control": "def",
    "hover_control": "hov",
    "pressed_control": "prs",
    "controls": [
      { "def@mesa_arcana.close_def": {} },
      { "hov@mesa_arcana.close_hov": {} },
      { "prs@mesa_arcana.close_prs": {} }
    ]
  },

  "close_def": {
    "type": "image",
    "texture": "textures/ui/mesa_close",
    "size": [ "100%", "100%" ]
  },
  "close_hov": {
    "type": "image",
    "texture": "textures/ui/mesa_close_hover",
    "size": [ "100%", "100%" ]
  },
  "close_prs": {
    "type": "image",
    "texture": "textures/ui/mesa_close",
    "size": [ "100%", "100%" ],
    "alpha": 0.7
  },

  "left_panel": {
    "type": "panel",
    "size": [ 120, 165 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 12, 30 ],
    "controls": [
      { "bg@mesa_arcana.panel_bg": {} },
      { "header@mesa_arcana.left_header": {} },
      { "hint@mesa_arcana.left_hint": {} }
    ]
  },

  "panel_bg": {
    "type": "image",
    "texture": "textures/ui/mesa_panel",
    "size": [ "100%", "100%" ],
    "alpha": 0.85
  },

  "left_header": {
    "type": "label",
    "text": "§d§lItens",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 6 ],
    "layer": 3
  },

  "left_hint": {
    "type": "label",
    "text": "§7Lista de receitas\n§8controlada pelo\n§8Script API\n\n§a✓ = pode craftar\n§c✗ = faltam itens",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, 24 ],
    "layer": 3
  },

  "center_panel": {
    "type": "panel",
    "size": [ 210, 165 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -12, 30 ],
    "controls": [
      { "bg@mesa_arcana.panel_bg": {} },
      { "header@mesa_arcana.center_header": {} },
      { "hint@mesa_arcana.center_hint": {} }
    ]
  },

  "center_header": {
    "type": "label",
    "text": "§d§lDetalhes",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 6 ],
    "layer": 3
  },

  "center_hint": {
    "type": "label",
    "text": "§7Selecione um item\nna lista à esquerda\npara ver os requisitos\ne fabricar.\n\n§fRequisitos:\n§aVerde = possui\n§cVermelho = falta\n\n§eClique em Fabricar\nquando estiver pronto.",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 10, 24 ],
    "layer": 3
  },

  "bottom_bar": {
    "type": "panel",
    "size": [ 336, 26 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -8 ],
    "controls": [
      { "bg@mesa_arcana.panel_bg": {} },
      { "label@mesa_arcana.bottom_label": {} }
    ]
  },

  "bottom_label": {
    "type": "label",
    "text": "§8Inventário do jogador • slots rápidos permanecem acessíveis",
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 3
  }
}
